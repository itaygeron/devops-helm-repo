pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Build is done!'
            }
        }
	stage('Test') {
	    steps {
	        echo 'The tests have passed successfully!'
	    }
	}
	stage('Deploy') {
	    steps {
	        echo 'The app is deployed!'
	    }
	}
    }
}
